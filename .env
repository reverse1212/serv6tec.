# Copiá este archivo como ".env" y ajustá los valores. NUNCA subas ".env" a un repositorio.
PORT=3000
NODE_ENV=development

# Dominio público (sin barra final). Se usa para sitemap/canonical/Open Graph.
SITE_URL=http://localhost:3000

# Cookies "Secure" (solo HTTPS). En producción con HTTPS dejalo en true.
COOKIE_SECURE=false
# true si el servidor está detrás de un proxy (Render, Railway, Nginx...) para leer la IP real
TRUST_PROXY=false

SESSION_HOURS=12
MAX_IMAGE_MB=5
MAX_VIDEO_MB=100

# Opcional: rutas de datos (útil si tu hosting monta un disco persistente)
# DB_PATH=/data/servtec.db
# UPLOAD_DIR=/data/uploads
